# Groww API Credentials
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control

# ==========================================
# AUTHENTICATION METHOD 1: TOTP (Recommended)
# ==========================================
GROWW_TOTP_TOKEN=your_totp_token_here
GROWW_TOTP_SECRET=your_totp_secret_here

# ==========================================
# AUTHENTICATION METHOD 2: API Key + Secret
# ==========================================
# GROWW_API_KEY=your_api_key_here
# GROWW_API_SECRET=your_api_secret_here

# ==========================================
# TRADING CONFIGURATION
# ==========================================
INITIAL_CAPITAL=2000000
IS_LIVE=false

# Strategy
LOOKBACK=20
VOLUME_MULTIPLIER=1.5
MIN_RISK_REWARD=2.0
MAX_STOP_LOSS_PCT=0.03
COOLDOWN_BARS=10

# Trading interval: 1m, 2m, 3m, 5m, 10m, 15m, 30m, 1h
TRADE_INTERVAL=5m

# Midday entry pause (optional; DISABLED by default). Studies show 11:45-13:30
# is the highest-loss window in Indian intraday trading - enable for real money:
# ENTRY_PAUSE_START=11:45
# ENTRY_PAUSE_END=13:30
# Hard cap on new entries per day (0 = unlimited)
MAX_TRADES_PER_DAY=6

# India VIX regime filter (12-18 is the practitioner breakout sweet spot;
# wide guard by default). Fail-open if the index quote is unavailable.
VIX_FILTER_ENABLED=true
VIX_MIN=10
VIX_MAX=25

# Manual exclusion list for special days, e.g. results names:
# EXCLUDE_SYMBOLS=TCS,INFY

# Stop construction (widen both for faster bars, e.g. 2.5 / 15 on 1m)
STOP_ATR_MULT=1.5
RECENT_LOW_BARS=5
# Minimum stop distance (noise floor). 0.0075 = stops at least 0.75% away,
# so 2R targets are at least 1.5% - costs don't eat them whole.
MIN_STOP_PCT=0.0075

# Volatility gate (ATR%) - auto-scaled from the 5m baseline (0.3-4.0)
# unless set explicitly; on 1m bars it becomes ~0.13-1.79 automatically.
# MIN_VOLATILITY_PCT=
# MAX_VOLATILITY_PCT=

# Risk Management
MAX_POSITION_PCT=0.10
MAX_OPEN_POSITIONS=10
DAILY_LOSS_LIMIT_PCT=0.02
MAX_DRAWDOWN_PCT=0.05
MIN_CASH_RESERVE=100000

# Portfolio Costs
BROKERAGE_PCT=0.0003
STT_PCT=0.00025
SLIPPAGE_PCT=0.0002

# API Ports
API_PORT=8002
DASHBOARD_PORT=8501

# Streaming feed (REST fallback when off/stale/slow)
FEED_ENABLED=true
FEED_MAX_AGE_S=60
FEED_TIMEOUT_S=20
INSTRUMENTS_TTL_DAYS=7

# Selection
TOP_STOCKS=30
# Persistent watchlist (paper default): names are only ever ADDED during the
# day (up to WATCHLIST_MAX), so a stock dropped by a re-rank just before it
# wakes up cannot be missed. Classic top-N swapping: false.
WATCHLIST_PERSISTENT=true
WATCHLIST_MAX=60
# Evidence-backed filters (see docs/RESEARCH.md)
MIN_DAILY_ATR_PCT=1.0
MAX_DAILY_ATR_PCT=6.0
MIN_TURNOVER_CR=25
MIN_RVOL=1.0
MAX_GAP_PCT=5.0
MAX_SECTOR_POSITIONS=3
RESELECT_TIMES=09:30,11:00

# Strategy filters
TREND_EMA=20
VWAP_REQUIRED=true

# Sizing
HEAT_CAP_PCT=0.06
TARGET_VOL_PCT=1.5
THROTTLE_START_MULT=0.5

# Exits
PARTIAL_R=1.0
PARTIAL_FRAC=0.5
SCRATCH_BARS=12
SCRATCH_R=0.5
TRAIL_TIGHTEN_MULT=0.5
SCALE_1430_R=1.0

# Costs (NSE equity-intraday; verify vs contract note)
EXCHANGE_PCT=0.0000297
SEBI_PCT=0.000001
STAMP_PCT=0.00002
GST_PCT=0.18
SLIPPAGE_MAX_PCT=0.0004
# SLIPPAGE_SEED=
