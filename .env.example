# Groww API Credentials
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control

# ==========================================
# AUTHENTICATION METHOD 1: TOTP (Recommended)
# ==========================================
GROWw_TOTP_TOKEN=your_totp_token_here
GROWw_TOTP_SECRET=your_totp_secret_here

# ==========================================
# AUTHENTICATION METHOD 2: API Key + Secret
# ==========================================
# GROWW_API_KEY=your_api_key_here
# GROWW_API_SECRET=your_api_secret_here

# ==========================================
# TRADING CONFIGURATION
# ==========================================
INITIAL_CAPITAL=2000000
IS_LIVE=false

# Strategy
LOOKBACK=20
VOLUME_MULTIPLIER=1.5
MIN_RISK_REWARD=2.0
MAX_STOP_LOSS_PCT=0.03
COOLDOWN_BARS=10

# Risk Management
MAX_POSITION_PCT=0.10
MAX_OPEN_POSITIONS=10
DAILY_LOSS_LIMIT_PCT=0.02
MAX_DRAWDOWN_PCT=0.05
MIN_CASH_RESERVE=100000

# Portfolio Costs
BROKERAGE_PCT=0.0003
STT_PCT=0.00025
SLIPPAGE_PCT=0.0002

# API Ports
API_PORT=8002
DASHBOARD_PORT=8501
