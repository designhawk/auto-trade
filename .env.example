# Groww API Credentials
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control

# ==========================================
# AUTHENTICATION METHOD 1: TOTP (Recommended)
# ==========================================
GROWW_TOTP_TOKEN=your_totp_token_here
GROWW_TOTP_SECRET=your_totp_secret_here

# ==========================================
# AUTHENTICATION METHOD 2: API Key + Secret
# ==========================================
# GROWW_API_KEY=your_api_key_here
# GROWW_API_SECRET=your_api_secret_here

# ==========================================
# TRADING CONFIGURATION
# ==========================================
INITIAL_CAPITAL=2000000
IS_LIVE=false

# Strategy
LOOKBACK=20
VOLUME_MULTIPLIER=1.5
MIN_RISK_REWARD=2.0
MAX_STOP_LOSS_PCT=0.03
COOLDOWN_BARS=10

# Risk Management
MAX_POSITION_PCT=0.10
MAX_OPEN_POSITIONS=10
DAILY_LOSS_LIMIT_PCT=0.02
MAX_DRAWDOWN_PCT=0.05
MIN_CASH_RESERVE=100000

# Portfolio Costs
BROKERAGE_PCT=0.0003
STT_PCT=0.00025
SLIPPAGE_PCT=0.0002

# API Ports
API_PORT=8002
DASHBOARD_PORT=8501

# Streaming feed (REST fallback when off/stale)
FEED_ENABLED=true
FEED_MAX_AGE_S=60
INSTRUMENTS_TTL_DAYS=7

# Selection
TOP_STOCKS=30
MIN_VOLUME=500000
MAX_SECTOR_POSITIONS=3
RESELECT_TIMES=09:30,11:00

# Strategy filters
TREND_EMA=20
VWAP_REQUIRED=true

# Sizing
HEAT_CAP_PCT=0.06
TARGET_VOL_PCT=1.5
THROTTLE_START_MULT=0.5

# Exits
PARTIAL_R=1.0
PARTIAL_FRAC=0.5
SCRATCH_BARS=12
SCRATCH_R=0.5
TRAIL_TIGHTEN_MULT=0.5
SCALE_1430_R=1.0

# Costs (NSE equity-intraday; verify vs contract note)
EXCHANGE_PCT=0.0000297
SEBI_PCT=0.000001
STAMP_PCT=0.00002
GST_PCT=0.18
SLIPPAGE_MAX_PCT=0.0004
# SLIPPAGE_SEED=
